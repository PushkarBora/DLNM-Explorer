Lag_Tuning = "manual", Lag = 12,
Cost_Range = c(1, 10, 3),          # 1, 4, 7, 10
Gamma_Range = c(0.01, 0.05, 0.02), # 0.01, 0.03, 0.05
Epsilon_Range = c(0.01, 0.1, 0.09)) # 0.01, 0.1
fit2$Best_Params
# Defaults: lag and SVR parameters tuned jointly by grid search
fit3 <- IFSVR(dat, Class = 3, Split = 0.8)
head(fit3$Tuning$History)

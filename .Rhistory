geom_line(linewidth = 1.2) +
geom_point(size = 2) +
scale_x_date(date_labels = "%b %d", date_breaks = "1 day") +
labs(
title = "CRAN Download Momentum Comparison",
subtitle = "Tracking ARInfoLSTM vs GARCHInfoLSTM",
x = "Date",
y = "Daily Downloads",
color = "Package"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))

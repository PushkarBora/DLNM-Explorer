library(IFSVR)
set.seed(123)
dat <- 50 + 10 * sin(2 * pi * (1:120) / 12) + rnorm(120)
# Everything manual: lag 12, fixed SVR parameters
fit1 <- IFSVR(dat, Class = 3, Split = 0.8,
Lag_Tuning = "manual", Lag = 12,
SVR_Tuning = "manual", Cost = 8, Gamma = 0.01, Epsilon = 0.05)
fit1
# Manual lag, SVR parameters tuned on a small grid
